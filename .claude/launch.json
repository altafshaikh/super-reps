{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Expo (Metro bundler)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start"],
      "port": 8081
    },
    {
      "name": "Expo Web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web"],
      "port": 8081
    },
    {
      "name": "Web Preview (built)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "serve"],
      "port": 3000
    }
  ]
}
